{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiangsheng.genealogy/schemas/edges.json",
  "title": "Xiangsheng mentor edges",
  "type": "object",
  "required": ["edges"],
  "additionalProperties": false,
  "properties": {
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "type", "sources"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "const": "mentor" },
          "disputed": { "type": "boolean" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
