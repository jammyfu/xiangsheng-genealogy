{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiangsheng.genealogy/schemas/person.json",
  "title": "Xiangsheng person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "generation",
    "generationIndex",
    "bio",
    "works",
    "sources",
    "portraitKind"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "nameHant": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "generation": {
      "anyOf": [
        { "type": "string", "enum": ["德", "寿", "宝", "文", "明"] },
        { "type": "null" }
      ]
    },
    "generationIndex": { "type": "integer", "minimum": 1, "maximum": 10 },
    "birthYear": { "type": ["integer", "null"] },
    "deathYear": { "type": ["integer", "null"] },
    "floruit": { "type": "string" },
    "school": { "type": "string" },
    "bio": { "type": "string", "minLength": 12 },
    "works": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "portrait": { "type": ["string", "null"] },
    "portraitKind": {
      "type": "string",
      "enum": ["placeholder", "public-domain", "external"]
    },
    "disputed": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
